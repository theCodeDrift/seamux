{
  "name": "seamux",
  "version": "0.3.0",
  "description": "A board over every Claude Code and Codex session on your Mac, and the tools to drive and dispatch them.",
  "license": "MIT",
  "author": "Jakob Heuser <jakob@codedrift.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecodedrift/seamux.git"
  },
  "homepage": "https://github.com/thecodedrift/seamux#readme",
  "bugs": {
    "url": "https://github.com/thecodedrift/seamux/issues"
  },
  "type": "module",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "seamux": "bin/seamux"
  },
  "scripts": {
    "seamux": "bin/seamux",
    "dev": "react-router dev",
    "land": "node --no-warnings scripts/land.ts",
    "build": "react-router build && node --no-warnings scripts/build-dist.ts",
    "start": "npm run build && SEAMUX_COMPILED=1 bin/seamux",
    "prepack": "npm run build",
    "changeset": "changeset",
    "bump": "changeset version && npm install --package-lock-only --ignore-scripts",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:cmux": "vitest run --config vitest.cmux.config.ts",
    "prepare": "husky",
    "check": "taskless test && taskless check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@react-router/express": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "express": "^4.22.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isbot": "^5.1.36",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.2.2",
    "@taskless/cli-nightly": "0.12.0-20261002181147x023048f",
    "@types/express": "^4.17.25",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rolldown": "^1.2.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.2"
  },
  "files": [
    "bin/",
    "build/",
    "dist/",
    "scripts/login-browser.sh",
    "skills/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ]
}
